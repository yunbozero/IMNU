<view class="page" wx:if="{{cat}}">

  <view class="hero {{cat.tint}}">
    <!-- 有照片显示照片；没有 / 加载失败就回落 emoji + 底色（和物品那边同一个套路） -->
    <image
      wx:if="{{photo && !photoFailed}}"
      class="thumb-img"
      src="{{photo}}"
      mode="aspectFill"
      binderror="onPhotoError"
    />
    <text wx:else class="hero__emoji">{{cat.emoji}}</text>
  </view>

  <view class="name-row">
    <text class="name">{{cat.name}}</text>
    <text class="tag {{cat.status === 'onCampus' ? 'tag--green' : 'tag--grey'}}">{{cat.statusText}}</text>
  </view>

  <view class="panel">
    <view class="panel__row"><text class="panel__k">性别</text><text class="panel__v">{{cat.gender}}</text></view>
    <view class="panel__row"><text class="panel__k">出没地点</text><text class="panel__v">{{cat.location}}</text></view>
  </view>

  <!-- 相册：平铺缩略图，点开是全屏大图（wx.previewImage，可以左右滑/保存）。
       主图上面已经有了，这里不重复；每张图单独判加载失败，坏一张不影响其它。 -->
  <view class="card" wx:if="{{gallery.length}}">
    <view class="card__title">照片（{{gallery.length}} 张，点开看大图）</view>
    <view class="photos">
      <image
        wx:for="{{gallery}}"
        wx:key="*this"
        class="photos__item"
        src="{{item}}"
        mode="aspectFill"
        data-index="{{index}}"
        bindtap="previewPhoto"
      />
    </view>
  </view>

  <view class="card">
    <view class="card__title">性格</view>
    <view class="body-text">{{cat.personality}}</view>
  </view>

  <view class="notice" wx:if="{{cat.note}}">{{cat.note}}</view>

</view>

<!-- 这只猫已经不在图鉴里了（多半是被管理员删掉），别停在一片空白上 -->
<view class="page" wx:elif="{{missing}}">
  <view class="empty">
    <view class="empty__icon">🐾</view>
    <view class="empty__text">这只猫已经不在图鉴里了</view>
  </view>
</view>
