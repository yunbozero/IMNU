<view class="page" wx:if="{{cat}}">

  <view class="hero {{cat.tint}}">
    <!-- 有照片显示照片；没有 / 加载失败就回落 emoji + 底色（和物品那边同一个套路） -->
    <image
      wx:if="{{photo && !photoFailed}}"
      class="thumb-img"
      src="{{photo}}"
      mode="aspectFill"
      binderror="onPhotoError"
    />
    <text wx:else class="hero__emoji">{{cat.emoji}}</text>
  </view>

  <view class="name-row">
    <text class="name">{{cat.name}}</text>
    <text class="tag {{cat.status === 'onCampus' ? 'tag--green' : 'tag--grey'}}">{{statusText}}</text>
  </view>

  <view class="panel">
    <view class="panel__row"><text class="panel__k">性别</text><text class="panel__v">{{cat.gender}}</text></view>
    <view class="panel__row"><text class="panel__k">出没地点</text><text class="panel__v">{{cat.location}}</text></view>
  </view>

  <view class="card">
    <view class="card__title">性格</view>
    <view class="body-text">{{cat.personality}}</view>
  </view>

  <view class="notice" wx:if="{{cat.note}}">{{cat.note}}</view>

</view>
