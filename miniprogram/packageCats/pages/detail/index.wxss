/* 自定义导航栏：浮在内容上面（fixed），底色半透明 —— 大图滚到它下面时还能看清字。 */
.navbar {
  position: fixed; top: 0; left: 0; right: 0; z-index: 20;
  background: rgba(251, 237, 231, 0.92);
}
.navbar__bar { display: flex; align-items: center; gap: 12rpx; padding-left: 8rpx; }
.navbar__back {
  width: 72rpx; height: 100%; flex: 0 0 auto;
  display: flex; align-items: center; justify-content: center;
  font-size: 52rpx; color: var(--text); line-height: 1;
}
.navbar__title {
  font-size: 32rpx; font-weight: 700;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}

.hero {
  width: 100%; height: 560rpx; border-radius: 32rpx; margin-top: 28rpx;
  display: flex; align-items: center; justify-content: center;
}
.hero__emoji { font-size: 200rpx; }
.name-row { display: flex; align-items: center; gap: 20rpx; margin: 32rpx 4rpx 0; }
.name { font-size: 44rpx; font-weight: 800; }
.body-text { font-size: 28rpx; color: var(--text-2); line-height: 1.7; }

/* 相册：三列网格。★ 宽度只能用百分比 —— calc() 里写 rpx 在客户端编译期就被
   换成 px，真机上这条声明会整条失效（列表页踩过这个坑，有测试守着）。 */
.photos { display: flex; flex-wrap: wrap; justify-content: space-between; row-gap: 12rpx; }
.photos__item { width: 32%; height: 200rpx; border-radius: 16rpx; }
