.hero {
  width: 100%; height: 560rpx; border-radius: 32rpx; margin-top: 28rpx;
  display: flex; align-items: center; justify-content: center;
}
.hero__emoji { font-size: 200rpx; }
.name-row { display: flex; align-items: center; gap: 20rpx; margin: 32rpx 4rpx 0; }
.name { font-size: 44rpx; font-weight: 800; }
.body-text { font-size: 28rpx; color: var(--text-2); line-height: 1.7; }
