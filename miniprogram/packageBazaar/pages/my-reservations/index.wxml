<view class="page">

  <view class="segmented">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="segmented__item {{active === item.key ? 'segmented__item--on' : ''}}"
      data-key="{{item.key}}"
      bindtap="onTabTap"
    >{{item.label}}{{item.key === 'reserved' && pendingCount ? ' (' + pendingCount + ')' : ''}}</view>
  </view>

  <view wx:if="{{error}}" class="notice notice--strong" bindtap="load">
    <text class="notice__b">加载失败：</text>{{error}}（点一下重试）
  </view>

  <view wx:if="{{!loading && list.length === 0}}" class="empty">
    <view class="empty__icon">🎫</view>
    <view class="empty__text">这里还没有记录</view>
    <button class="btn" bindtap="goItems">去看看有什么</button>
  </view>

  <view
    wx:for="{{list}}"
    wx:key="id"
    class="res"
    data-id="{{item.id}}"
    bindtap="goPickup"
    hover-class="res--hover"
  >
    <view class="res__thumb {{item.tint}}">{{item.emoji || '🎁'}}</view>
    <view class="grow">
      <view class="res__name">{{item.itemName}}</view>
      <view class="res__stall">{{item.stallName}} · ×{{item.qty}}</view>
      <view class="res__row">
        <text class="res__sub">{{item.subText}}</text>
        <text class="{{item.statusClass}}">{{item.statusText}}</text>
      </view>
    </view>
  </view>

</view>
