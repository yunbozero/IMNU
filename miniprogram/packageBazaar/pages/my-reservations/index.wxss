.segmented {
  display: flex; gap: 8rpx; background: #F3E2D9;
  border-radius: 26rpx; padding: 8rpx; margin: 28rpx 0;
}
.segmented__item {
  flex: 1; text-align: center; font-size: 26rpx; font-weight: 600;
  color: var(--text-2); padding: 16rpx 0; border-radius: 20rpx;
  overflow: hidden; white-space: nowrap;
}
.segmented__item--on { background: var(--brand); color: #fff; }

.res {
  display: flex; gap: 24rpx;
  background: #fff; border-radius: 32rpx; padding: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(150, 90, 60, 0.06);
}
.res--hover { opacity: 0.8; }
.res__thumb {
  width: 172rpx; height: 156rpx; flex: 0 0 172rpx; border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center; font-size: 64rpx;
}
.res__name {
  font-size: 29rpx; font-weight: 600; line-height: 1.3;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.res__stall { font-size: 23rpx; color: var(--text-2); margin-top: 8rpx; }
.res__row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 16rpx; }
.res__sub {
  font-size: 22rpx; color: var(--text-2);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
