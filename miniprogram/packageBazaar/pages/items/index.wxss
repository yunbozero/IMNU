.search {
  display: flex; align-items: center; gap: 16rpx;
  height: 88rpx; border-radius: 44rpx; background: #fff;
  padding: 0 32rpx; margin-top: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(150, 90, 60, 0.06);
}
.search__icon { font-size: 28rpx; color: var(--text-3); }
.search__input { flex: 1; font-size: 28rpx; }

.segmented {
  display: flex; gap: 8rpx; background: #F3E2D9;
  border-radius: 26rpx; padding: 8rpx; margin: 28rpx 0;
}
.segmented__item {
  flex: 1; text-align: center; font-size: 26rpx; font-weight: 600;
  color: var(--text-2); padding: 16rpx 0; border-radius: 20rpx;
  overflow: hidden; white-space: nowrap;
}
.segmented__item--on { background: var(--brand); color: #fff; }

.grid { display: flex; flex-wrap: wrap; gap: 24rpx; }
.item {
  width: calc(50% - 12rpx); box-sizing: border-box;
  background: #fff; border-radius: 32rpx; padding: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(150, 90, 60, 0.06);
}
.item--hover { opacity: 0.75; }
.item--out { opacity: 0.72; }
.item__thumb {
  width: 100%; height: 232rpx; border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 84rpx; position: relative; overflow: hidden;
}
.item__soldout {
  position: absolute; inset: 0;
  background: rgba(255, 255, 255, 0.62);
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 600; color: #fff;
}
.item__soldout::after {
  content: ''; position: absolute; width: 160rpx; height: 52rpx;
  background: rgba(43, 33, 25, 0.72); border-radius: 26rpx; z-index: -1;
}
.item__name {
  font-size: 27rpx; font-weight: 600; line-height: 1.35; margin: 16rpx 4rpx 0;
  height: 74rpx; overflow: hidden;
}
.item__stall { font-size: 22rpx; color: var(--text-3); margin: 4rpx 4rpx 0; }
