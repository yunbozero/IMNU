<view class="page">

  <view wx:if="{{error}}" class="notice notice--strong" bindtap="load">
    <text class="notice__b">打不开：</text>{{error}}（点一下重试）
  </view>

  <block wx:if="{{!error}}">
    <view class="summary" wx:if="{{summary}}">{{summary}}</view>

    <!-- 搜索：学生那一块人多，翻起来累。跨角色搜，找人不该先知道他是哪一档 -->
    <view class="search">
      <text class="search__icon">🔍</text>
      <input
        class="search__input"
        value="{{keyword}}"
        placeholder="按昵称搜人"
        confirm-type="search"
        bindinput="onSearch"
      />
      <text wx:if="{{keyword}}" class="search__clear" bindtap="clearSearch">清除</text>
    </view>

    <view wx:if="{{searching && sections.length === 0}}" class="empty">
      <view class="empty__icon">🔍</view>
      <view class="empty__text">没找到叫「{{keyword}}」的已登记账号</view>
    </view>

    <!-- 我的账号：单独一块，跟在超管后面。改权限时最常看的就是这两块。 -->
    <view class="block" wx:if="{{meCard}}">
      <view class="block__head">
        <text class="block__title">我的账号</text>
        <text class="tag {{meCard.role === 'owner' ? 'tag--green' : 'tag--grey'}}">{{meCard.roleLabel}}</text>
      </view>
      <view class="grid">
        <view class="u u--me" data-id="{{meCard.id}}" bindtap="openDetail" hover-class="u--hover">
          <view class="u__avatar">
            <image wx:if="{{meCard.avatarUrl}}" class="u__avatar-img" src="{{meCard.avatarUrl}}" mode="aspectFill" />
            <text wx:else>{{meCard.initial}}</text>
          </view>
          <view class="u__name">{{meCard.name}}</view>
        </view>
      </view>
    </view>

    <!-- 按角色分块：每块一行两个 -->
    <view class="block" wx:for="{{sections}}" wx:key="key">
      <view class="block__head">
        <text class="block__title">{{item.label}}</text>
        <text class="block__count">{{item.count}} 人{{item.limit ? ' / 上限 ' + item.limit : ''}}</text>
      </view>

      <view class="empty" wx:if="{{item.users.length === 0}}">
        <view class="empty__text">还没有{{item.label}}</view>
      </view>

      <view class="grid" wx:else>
        <view
          wx:for="{{item.users}}"
          wx:key="id"
          wx:for-item="u"
          class="u"
          data-id="{{u.id}}"
          bindtap="openDetail"
          hover-class="u--hover"
        >
          <view class="u__avatar">
            <image wx:if="{{u.avatarUrl}}" class="u__avatar-img" src="{{u.avatarUrl}}" mode="aspectFill" />
            <text wx:else>{{u.initial}}</text>
          </view>
          <view class="u__name">{{u.name}}<text wx:if="{{u.isSelf}}" class="u__me">你自己</text></view>
        </view>
      </view>
    </view>

    <view class="notice">
      <text class="notice__b">改完立刻生效</text>，但对方要重新进一次「我的」页才会看到新入口。
      超管身份只能「转交」，不能直接把谁改成超管。
    </view>
  </block>

  <!-- 详情弹层：点卡片打开，权限按钮都在这里 -->
  <view wx:if="{{detail}}" class="mask" bindtap="closeDetail">
    <view class="sheet" catchtap="noop">
      <view class="sheet__grab"></view>

      <view class="detail-head">
        <view class="u__avatar u__avatar--lg">
          <image wx:if="{{detail.avatarUrl}}" class="u__avatar-img" src="{{detail.avatarUrl}}" mode="aspectFill" />
          <text wx:else>{{detail.initial}}</text>
        </view>
        <view class="grow">
          <view class="detail-name">{{detail.name}}</view>
          <view class="detail-meta">
            <text class="tag {{detail.role === 'owner' ? 'tag--green' : 'tag--grey'}}">{{detail.roleLabel}}</text>
            <text wx:if="{{detail.isSelf}}" class="detail-self">这是你自己</text>
          </view>
        </view>
      </view>

      <view wx:if="{{detail.isSelf}}" class="notice">
        <text class="notice__b">不能修改自己的身份</text> —— 防止一次误点让系统失去超管。
      </view>

      <block wx:if="{{!detail.isSelf && detail.settable.length}}">
        <view class="detail-k">改成</view>
        <view class="ops">
          <button
            wx:for="{{detail.settable}}"
            wx:key="*this"
            class="op"
            data-id="{{detail.id}}"
            data-role="{{item}}"
            data-name="{{detail.name}}"
            disabled="{{busyId === detail.id}}"
            bindtap="changeRole"
          >{{detail.settableLabels[index]}}</button>
        </view>
      </block>

      <!-- 内容处置：头像没有自动检测，至少管理员能当场抹掉 -->
      <button
        wx:if="{{detail.avatar && !detail.isSelf}}"
        class="btn btn--ghost"
        data-id="{{detail.id}}"
        data-name="{{detail.name}}"
        disabled="{{busyId === detail.id}}"
        bindtap="clearAvatar"
      >清掉 TA 的头像</button>

      <button
        wx:if="{{detail.canTransferOwner}}"
        class="btn btn--ghost"
        data-id="{{detail.id}}"
        data-name="{{detail.name}}"
        disabled="{{busyId === detail.id}}"
        bindtap="transfer"
      >把超管转交给 TA</button>

      <button class="btn btn--grey" bindtap="closeDetail">关闭</button>
    </view>
  </view>
</view>
