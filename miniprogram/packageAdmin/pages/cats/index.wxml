<view class="page">

  <!-- 可改文案：改完学生端刷新就能看到，不用发版提审。 -->
  <view wx:if="{{canEditCopy}}" class="card copycard">
    <view class="card__title">图鉴文案 · 喂养提示</view>
    <view class="copyhint">学生端「猫猫图鉴」底部那张卡片。改完保存即生效，不用发版。</view>

    <input class="copyinput copyinput--title" value="{{copyTitle}}" maxlength="20" placeholder="标题" bindinput="onCopyTitle" />

    <view wx:for="{{copyItems}}" wx:key="index" class="copyrow">
      <input class="copyinput copyinput--label" value="{{item.label}}" maxlength="6" placeholder="标签" data-idx="{{index}}" data-field="label" bindinput="onCopyItem" />
      <input class="copyinput copyinput--text" value="{{item.text}}" maxlength="60" placeholder="说明" data-idx="{{index}}" data-field="text" bindinput="onCopyItem" />
      <text class="copyrow__del" data-idx="{{index}}" bindtap="removeCopyItem">✕</text>
    </view>

    <view wx:if="{{copyError}}" class="notice notice--strong">{{copyError}}</view>

    <view class="copyops">
      <button class="btn btn--ghost copybtn" bindtap="addCopyItem">＋ 加一行</button>
      <button class="btn copybtn" loading="{{savingCopy}}" disabled="{{savingCopy}}" bindtap="saveCopy">保存文案</button>
    </view>
  </view>

  <view wx:if="{{error}}" class="notice notice--strong" bindtap="load">
    <text class="notice__b">打不开：</text>{{error}}（点一下重试）
  </view>

  <button wx:if="{{!error}}" class="btn newbtn" bindtap="goNew">＋ 新加一只猫</button>

  <view wx:if="{{!loading && !error && list.length === 0}}" class="empty">
    <view class="empty__icon">🐈</view>
    <view class="empty__text">图鉴里还没有猫</view>
  </view>

  <view wx:for="{{list}}" wx:key="id" class="cat">
    <view class="cat__head">
      <view class="cat__thumb {{item.tint}}">
        <image
          wx:if="{{item.photo && !imageFailed[item.id]}}"
          class="thumb-img"
          src="{{item.photo}}"
          mode="aspectFill"
          lazy-load
          data-id="{{item.id}}"
          binderror="onImageError"
        />
        <text wx:else>{{item.emoji}}</text>
      </view>
      <view class="grow">
        <view class="cat__name">{{item.name}}</view>
        <view class="cat__sub">
          {{item.location || '没写地点'}}
          <text class="tag {{item.status === 'onCampus' ? 'tag--green' : 'tag--grey'}}">{{item.statusText}}</text>
        </view>
      </view>
    </view>

    <view class="cat__ops">
      <button
        class="op"
        data-id="{{item.id}}"
        disabled="{{busyId === item.id}}"
        bindtap="goEdit"
      >改资料</button>
      <button
        class="op"
        data-id="{{item.id}}"
        disabled="{{busyId === item.id}}"
        bindtap="changePhoto"
      >{{item.photo ? '换照片' : '配照片'}}</button>
      <button
        class="op op--del"
        data-id="{{item.id}}"
        disabled="{{busyId === item.id}}"
        bindtap="removeCat"
      >删除</button>
    </view>
  </view>

  <view class="notice">
    <text class="notice__b">「离世」是一个状态，不是删除。</text>
    不在了的猫改成失踪或离世，图鉴里要留着纪念。
  </view>

</view>
