/* 管理端 · 加猫 / 改资料。样式只在这个分包里用。 */

.field { margin-top: 26rpx; }
.field--last { margin-bottom: 4rpx; }

.field__k { font-size: 25rpx; color: var(--text-2); margin-bottom: 12rpx; }

.field__input {
  padding: 22rpx 26rpx;
  border-radius: 22rpx;
  background: #F9F4F1;
  font-size: 29rpx;
}

.field__area {
  width: 100%;
  box-sizing: border-box;
  height: 140rpx;
  padding: 22rpx 26rpx;
  border-radius: 22rpx;
  background: #F9F4F1;
  font-size: 29rpx;
}

/* picker 里面没法直接套用 input 的样式，所以给个长得一样的壳 */
.field__pick {
  padding: 22rpx 26rpx;
  border-radius: 22rpx;
  background: #F9F4F1;
  font-size: 29rpx;
}

/* ---------- 照片 ---------- */
.photo { display: flex; align-items: flex-start; gap: 24rpx; }

.photo__box {
  width: 220rpx; height: 220rpx; border-radius: 28rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 88rpx; flex: 0 0 auto;
  overflow: hidden;
}

.photo__ops { flex: 1; min-width: 0; }

.photo__hint {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: var(--text-3);
  line-height: 1.5;
}

/* 小号按钮：和物品名额页那些 .op 长得一样，但那个类在另一个页面的 wxss 里 */
.op {
  margin: 0 0 14rpx; padding: 0 30rpx; line-height: 2.3;
  font-size: 26rpx; font-weight: 600;
  background: #F6EFEA; color: var(--text);
  border: 0; border-radius: 22rpx;
}
.op::after { border: 0; }

.chips { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 16rpx; }

.chip {
  width: 76rpx; height: 76rpx; border-radius: 22rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 38rpx; background: #F9F4F1;
}

.swatch {
  min-width: 92rpx; padding: 0 24rpx; height: 66rpx;
  border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; color: var(--text-2);
}
.swatch--on {
  font-weight: 700;
  color: var(--brand-dark);
  /* 底色本身很浅，选中必须有描边才看得出来 —— 光靠 .t-* 那个背景区分不了 */
  box-shadow: inset 0 0 0 4rpx var(--brand);
}

.save { margin-top: 32rpx; }
