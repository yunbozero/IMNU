/* 管理端 · 新建物品。样式只在这个分包里用。 */

.field { margin-top: 26rpx; }
.field--last { margin-bottom: 4rpx; }

.field__k { font-size: 25rpx; color: var(--text-2); margin-bottom: 12rpx; }

.field__input {
  padding: 22rpx 26rpx;
  border-radius: 22rpx;
  background: #F9F4F1;
  font-size: 29rpx;
}

.field__area {
  width: 100%;
  box-sizing: border-box;
  height: 140rpx;
  padding: 22rpx 26rpx;
  border-radius: 22rpx;
  background: #F9F4F1;
  font-size: 29rpx;
}

/* picker 里面没法直接套用 input 的样式，所以给个长得一样的壳 */
.field__pick {
  padding: 22rpx 26rpx;
  border-radius: 22rpx;
  background: #F9F4F1;
  font-size: 29rpx;
}

/* 图标预览：和物品列表里那个方块的观感保持一致，选了底色当场能看到 */
.preview {
  width: 92rpx; height: 92rpx; border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx; flex: 0 0 auto; margin-right: 18rpx;
}

.chips { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 16rpx; }

.chip {
  width: 76rpx; height: 76rpx; border-radius: 22rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 38rpx; background: #F9F4F1;
}

.swatch {
  min-width: 92rpx; padding: 0 24rpx; height: 66rpx;
  border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; color: var(--text-2);
}
.swatch--on {
  font-weight: 700;
  color: var(--brand-dark);
  /* 底色本身很浅，选中必须有描边才看得出来 —— 光靠 .t-* 那个背景区分不了 */
  box-shadow: inset 0 0 0 4rpx var(--brand);
}

.save { margin-top: 32rpx; }
