<view class="page">

  <view wx:if="{{error}}" class="notice notice--strong" bindtap="load">
    <text class="notice__b">打不开：</text>{{error}}（点一下重试）
  </view>

  <block wx:if="{{!error}}">

    <view class="card">
      <view class="card__title">新加一件物品</view>

      <!-- 大预览：学生看到的就是这个样子。有照片显示照片，没照片显示 emoji + 底色。 -->
      <view class="field">
        <view class="field__k">照片（可不加）</view>
        <view class="photo">
          <view class="photo__box {{tint}}">
            <image
              wx:if="{{imagePreview}}"
              class="thumb-img"
              src="{{imagePreview}}"
              mode="aspectFill"
            />
            <text wx:else class="photo__ph">{{emoji || '🎁'}}</text>
          </view>
          <view class="photo__ops">
            <button class="op" bindtap="pickImage">{{imagePreview ? '换一张' : '选一张照片'}}</button>
            <button wx:if="{{imagePreview}}" class="op" bindtap="removeImage">不要照片</button>
            <view wx:if="{{!imagePreview}}" class="photo__hint">
              不选也行 —— 会用下面的图标当占位
            </view>
          </view>
        </view>
      </view>

      <view class="field">
        <view class="field__k">名称</view>
        <input
          class="field__input"
          maxlength="{{nameMax}}"
          placeholder="比如：手作黄油曲奇"
          value="{{name}}"
          bindinput="onName"
        />
      </view>

      <view class="field">
        <view class="field__k">没照片时显示什么</view>
        <input
          class="field__input"
          maxlength="2"
          placeholder="一个 emoji，或一两个字"
          value="{{emoji}}"
          bindinput="onEmoji"
        />
        <view class="chips">
          <view
            wx:for="{{emojis}}"
            wx:key="*this"
            class="chip"
            data-emoji="{{item}}"
            bindtap="pickEmoji"
          >{{item}}</view>
        </view>
      </view>

      <view class="field">
        <view class="field__k">底色</view>
        <view class="chips">
          <view
            wx:for="{{tints}}"
            wx:key="key"
            class="swatch {{item.key}} {{tint === item.key ? 'swatch--on' : ''}}"
            data-key="{{item.key}}"
            bindtap="pickTint"
          >{{item.label}}</view>
        </view>
      </view>

      <view class="field">
        <view class="field__k">名额</view>
        <input
          class="field__input"
          type="number"
          placeholder="总共有多少份"
          value="{{totalQuota}}"
          bindinput="onQuota"
        />
      </view>

      <view class="field">
        <view class="field__k">简介（可不填）</view>
        <textarea
          class="field__area"
          maxlength="{{descMax}}"
          placeholder="比如：独立包装，一盒六块"
          value="{{description}}"
          bindinput="onDesc"
        />
      </view>

      <view class="field field--last">
        <view class="field__k">摊位</view>
        <picker mode="selector" range="{{stallNames}}" value="{{stallIndex}}" bindchange="onStall">
          <view class="field__pick">{{stallNames[stallIndex]}}</view>
        </picker>
      </view>
    </view>

    <view class="notice">
      <text class="notice__b">保存后这件物品立刻在售，学生马上就能预定。</text>
      想先藏着就别建；建完想撤，回「物品名额」把它下架。照片传上去之后就确定了，
      要换得回列表点「换图」。
    </view>

    <button
      class="btn save"
      disabled="{{submitting}}"
      bindtap="submit"
    >{{submitting ? '保存中…' : '保存并上架'}}</button>

  </block>

</view>
