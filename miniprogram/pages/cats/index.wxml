<view class="page page--tabbar">

  <view class="cats-hero">
    <view class="cats-hero__avatar">🐾</view>
    <view class="cats-hero__title">盛师猫猫 · 猫咪图鉴</view>
    <view class="cats-hero__sub">关爱校园里的每一条小生命</view>
  </view>

  <view class="segmented">
    <view
      wx:for="{{groups}}"
      wx:key="key"
      class="segmented__item {{active === item.key ? 'segmented__item--on' : ''}}"
      data-key="{{item.key}}"
      bindtap="onTabTap"
    >{{item.label}}</view>
  </view>

  <!-- 搜索：跨分组搜名字/昵称/地点/品种/毛色/性格/校区 -->
  <view class="search">
    <text class="search__icon">🔍</text>
    <input
      class="search__input"
      value="{{keyword}}"
      placeholder="搜名字、地点、品种，比如「东门」「橘」"
      confirm-type="search"
      bindinput="onSearch"
    />
    <text wx:if="{{keyword}}" class="search__clear" bindtap="clearSearch">清除</text>
  </view>

  <!-- 连缓存都没有、又没问到接口：给一句人话，而不是一片空白让人以为图鉴坏了 -->
  <view wx:if="{{offline}}" class="empty" bindtap="refresh">
    <view class="empty__icon">📡</view>
    <view class="empty__text">暂时连不上，点一下重试</view>
  </view>

  <view wx:elif="{{list.length === 0}}" class="empty">
    <view class="empty__icon">{{searching ? '🔍' : '🐈'}}</view>
    <view class="empty__text">{{searching ? '没搜到，换个词试试（试试地名或毛色）' : '这一栏暂时没有记录'}}</view>
  </view>

  <view class="cat-grid">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="cat-card"
      data-id="{{item.id}}"
      bindtap="goDetail"
      hover-class="cat-card--hover"
    >
      <view class="cat-card__thumb {{item.tint}}">
        <image
          wx:if="{{item.photo && !photoFailed[item.id]}}"
          class="thumb-img"
          src="{{item.photo}}"
          mode="aspectFill"
          lazy-load
          data-id="{{item.id}}"
          binderror="onPhotoError"
        />
        <text wx:else>{{item.emoji}}</text>
      </view>
      <view class="cat-card__name">{{item.name}}</view>
      <view class="cat-card__loc">{{item.location}}</view>
    </view>
  </view>

  <view class="card">
    <view class="card__title">{{tipsTitle}}</view>
    <view wx:for="{{tips}}" wx:key="label" class="tip">
      <text class="tip__label {{item.tone === 'ok' ? 'tip__label--ok' : ''}}">{{item.label}}：</text>
      <text class="tip__text">{{item.text}}</text>
    </view>
  </view>

</view>
