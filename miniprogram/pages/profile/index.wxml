<view class="page page--tabbar">

  <!-- 已登记 -->
  <block wx:if="{{user}}">
    <view class="me">
      <view class="me__avatar">🎪</view>
      <view class="me__name">{{user.name}}</view>
      <view class="me__role">{{roleText}}</view>
    </view>

    <view class="grid2">
      <view class="entry entry--small" bindtap="goMyReservations" hover-class="entry--hover">
        <view class="entry__icon entry__icon--sm">🎫</view>
        <view class="entry__title entry__title--sm">我的预定</view>
        <view class="entry__desc entry__desc--sm">查看取货码</view>
      </view>
      <view class="entry entry--small" bindtap="goItems" hover-class="entry--hover">
        <view class="entry__icon entry__icon--sm">🎁</view>
        <view class="entry__title entry__title--sm">逛活动</view>
        <view class="entry__desc entry__desc--sm">看看还有什么</view>
      </view>
    </view>

    <view wx:if="{{isStaff}}" class="entry entry--staff" bindtap="goScan" hover-class="entry--hover">
      <view class="entry__icon">✅</view>
      <view class="grow">
        <view class="entry__title">志愿者核销台</view>
        <view class="entry__desc">扫码或输码，现场核销</view>
      </view>
      <view class="entry__arrow">›</view>
    </view>

    <!-- 管理端：只有副主任管理员及以上看得到。界面挡一道，真正的权限在服务端。 -->
    <view wx:if="{{isManager}}" class="entry entry--staff" bindtap="goAdmin" hover-class="entry--hover">
      <view class="entry__icon">📋</view>
      <view class="grow">
        <view class="entry__title">管理端 · 预定名单</view>
        <view class="entry__desc">查谁定了什么、搜取货码、撤销误核销</view>
      </view>
      <view class="entry__arrow">›</view>
    </view>

    <view wx:if="{{isManager}}" class="entry entry--staff" bindtap="goAdminItems" hover-class="entry--hover">
      <view class="entry__icon">📦</view>
      <view class="grow">
        <view class="entry__title">管理端 · 物品名额</view>
        <view class="entry__desc">临时加减名额、上下架、新建物品</view>
      </view>
      <view class="entry__arrow">›</view>
    </view>

    <!-- 活动与摊位：副主任能建摊位，一级管理员才能建/结束活动（页内再分一次） -->
    <view wx:if="{{isManager}}" class="entry entry--staff" bindtap="goAdminEvent" hover-class="entry--hover">
      <view class="entry__icon">📅</view>
      <view class="grow">
        <view class="entry__title">管理端 · 活动与摊位</view>
        <view class="entry__desc">建活动、结束活动、加摊位</view>
      </view>
      <view class="entry__arrow">›</view>
    </view>

    <!-- 图鉴：志愿者就够 —— 照片要在校园里拍完就传，猫猫组的人不一定是副主任 -->
    <view wx:if="{{isStaff}}" class="entry entry--staff" bindtap="goAdminCats" hover-class="entry--hover">
      <view class="entry__icon">🐱</view>
      <view class="grow">
        <view class="entry__title">管理端 · 图鉴管理</view>
        <view class="entry__desc">加猫、改资料、换照片，改完立刻生效</view>
      </view>
      <view class="entry__arrow">›</view>
    </view>

    <!-- 角色管理：一级管理员及以上。在这之前小程序里根本没有提权的入口 -->
    <view wx:if="{{isSeniorManager}}" class="entry entry--staff" bindtap="goAdminRoles" hover-class="entry--hover">
      <view class="entry__icon">🙋</view>
      <view class="grow">
        <view class="entry__title">管理端 · 角色管理</view>
        <view class="entry__desc">给志愿者开核销权限、换届转交超管</view>
      </view>
      <view class="entry__arrow">›</view>
    </view>

    <view class="card">
      <view class="card__title">活动规则</view>
      <view class="rule"><text class="rule__k">只登记名额：</text>小程序只登记预定名额，不占用其他同学的机会。</view>
      <view class="rule"><text class="rule__k">现场取货：</text>活动当天到对应摊位，出示取货码领取物品。</view>
      <view class="rule"><text class="rule__k">一人一份：</text>同一件物品每人限预定一次。</view>
      <view class="rule"><text class="rule__k rule__k--ok">及时取消：</text>无法到场请提前取消，把名额让给其他同学。</view>
    </view>

    <view class="logout" bindtap="onLogout">退出登录</view>
  </block>

  <!-- 还没登记 -->
  <block wx:else>
    <view class="me">
      <view class="me__avatar">👤</view>
      <view class="me__name">还没登记</view>
      <view class="me__sid">登记后才能预定名额</view>
    </view>

    <view class="notice notice--strong">
      <text class="notice__b">本小程序仅登记预定名额。</text>
      预定成功后，请于活动当天凭取货码到对应摊位领取。
    </view>

    <view class="card">
      <view class="field">
        <view class="field__label">昵称</view>
        <input
          class="field__input"
          maxlength="16"
          placeholder="起个昵称，取货时报一下就行"
          value="{{name}}"
          bindinput="onNameInput"
        />
        <view class="field__tip">只用来在取货时认出你，不需要真实姓名</view>
      </view>

      <view class="agree" bindtap="toggleAgree">
        <view class="agree__box {{agree ? 'agree__box--on' : ''}}"></view>
        <view class="agree__text">
          我已阅读并同意《活动规则》，承诺预定后按时取货；无故未取货将影响后续活动参与。
        </view>
      </view>

      <!-- 登记失败的原因留在这里，不随 toast 一起消失。
           真机上出问题时用户截得到这一行，比复述「点了没反应」有用得多。 -->
      <view wx:if="{{regError}}" class="notice notice--strong reg-error">
        <text class="notice__b">登记没成功：</text>{{regError}}
      </view>

      <button
        class="btn {{submitting ? 'btn--disabled' : ''}}"
        disabled="{{submitting}}"
        bindtap="submitRegister"
      >{{submitting ? '提交中…' : '完成登记'}}</button>
    </view>

    <view class="footer-note">只保存你的微信标识和昵称，活动结束后统一删除</view>
  </block>

</view>
